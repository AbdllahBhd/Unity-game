# ---- Unity generated folders ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Never ignore .meta files: Unity needs them. Only ignore metas of ignored folders.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- IDE / editor files generated by Unity ----
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- Build outputs ----
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Addressables / packed assets
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- OS files ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Python (Tools/) ----
__pycache__/
*.pyc

# ---- AI tooling ----
# Graph cache is rebuilt locally; the graph itself (graph.json, GRAPH_REPORT.md) is kept.
graphify-out/cache/
graphify-out/graph.html
.claude/settings.local.json
